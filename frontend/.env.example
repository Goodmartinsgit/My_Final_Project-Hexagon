# Frontend environment variables
# Copy this file to .env.local for local development overrides.
# Never commit .env.local or any file containing real credentials.

# ── API base URL ─────────────────────────────────────────────────────────────
# Points the frontend at the backend API.
#
# Local development (docker-compose):
#   VITE_API_URL=http://localhost:5000/api
#
# Production (set by the frontend-deploy.yml workflow via sed substitution):
#   VITE_API_URL=http://your-alb-dns-name.region.elb.amazonaws.com/api
#
# When a custom domain is attached to the ALB, use the domain name instead.
VITE_API_URL=http://localhost:5000/api
