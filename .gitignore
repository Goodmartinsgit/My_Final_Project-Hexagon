# ── Terraform ─────────────────────────────────────────────────────────────────
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
*.tfvars.json
.terraform.lock.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── SSH / TLS private keys — NEVER commit these ───────────────────────────────
*.pem
*.key

# terraform.tfvars contains real credentials — NEVER commit this file.
# Use terraform.tfvars.example as the committed template.
terraform.tfvars
**/terraform.tfvars

# Bootstrap terraform state (local, not committed)
terraform/bootstrap/.terraform/
terraform/bootstrap/terraform.tfstate
terraform/bootstrap/terraform.tfstate.backup

# ── Application secrets ────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml

# ── OS / Editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
