# terraform.tfvars.example
# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit real credentials.

# ── Project identity ──────────────────────────────────────────────────────────
# project_name is the prefix for ALL AWS resource names and tags.
# AWS ALB/ELB names do not support underscores — use hyphens only.
# Change this to rename every resource in the stack in one place.
project_name = "hexagon-final-project"
environment  = "dev"
aws_region   = "eu-west-1"
owner        = "martins"

# ── VPC ───────────────────────────────────────────────────────────────────────
# Defaults in variables.tf already match the layout below.
# Uncomment and override only if you need different CIDRs.
# vpc_cidr                 = "10.0.0.0/16"
# azs                      = ["eu-west-1a", "eu-west-1b"]
# public_subnet_cidrs      = ["10.0.0.0/20", "10.0.16.0/20"]
# private_app_subnet_cidrs = ["10.0.128.0/20", "10.0.144.0/20"]
# private_db_subnet_cidrs  = ["10.0.160.0/20", "10.0.176.0/20"]

# ── EC2 ───────────────────────────────────────────────────────────────────────
# Replace with the name of your EC2 key pair in the target AWS account.
key_pair_name    = "hexagon-key"
# Your current public IP in x.x.x.x/32 — locks down bastion SSH access.
my_ip_cidr       = "YOUR_IP_HERE/32"
web_instance_type = "t2.micro"
app_instance_type = "t2.micro"

# ── RDS ───────────────────────────────────────────────────────────────────────
db_instance_class    = "db.t3.micro"
db_name              = "app_db"
db_username          = "app_admin"
db_password          = "REPLACE_WITH_STRONG_PASSWORD"
db_allocated_storage = 20
db_multi_az          = false

# ── GitHub / OIDC ─────────────────────────────────────────────────────────────
# Must match the GitHub repository that runs the CI/CD workflows.
github_org  = "your-github-username-or-org"
github_repo = "Hexagon_Final_Project"
