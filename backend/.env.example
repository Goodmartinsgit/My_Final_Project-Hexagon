# Backend environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to source control.

# ── Database ──────────────────────────────────────────────────────────────────
# Full connection string (takes precedence over individual DB_* vars if set).
# In production, this is provided by the EC2 user_data script reading from
# AWS Systems Manager Parameter Store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demo_db

# Host used to construct the default DATABASE_URL when DATABASE_URL is not set.
DB_HOST=localhost

# ── Application ───────────────────────────────────────────────────────────────
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Runtime mode: development | test | production
ENV_MODE=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production, set this to your CloudFront distribution domain, e.g.:
#   ALLOWED_ORIGIN=https://d1234example.cloudfront.net
# Leaving it as * allows any origin — only acceptable for local development.
ALLOWED_ORIGIN=*
